# ============================================
# MINHAAJULHUDAA HUB - ENVIRONMENT CONFIGURATION
# ============================================
# BismiLLAH Ar-Rahman Ar-Roheem.
#
# Copy this file to .env and fill in your actual values.
# See MONOREPO.md for architecture details.

# ============================================
# DATABASE PROVIDER SELECTION
# ============================================
# Which database backend to use.
#   api       - React talks to Astro /api/db/* proxy; Lightbase key
#               stays server-side. RECOMMENDED for production. (default)
#   lightbase - React talks to Lightbase /api/v1 directly; key in bundle.
#               Use only for local dev when Astro backend is not running.
#   github    - Legacy GitHub-repo-as-database fallback.
VITE_DB_PROVIDER=api

# ============================================
# ASTRO BACKEND (required when VITE_DB_PROVIDER=api)
# ============================================
# URL of the Astro backend. In dev, Vite proxies /api to this.
# In production, set to the same origin as the app.
VITE_API_URL=http://localhost:4321/api

# ============================================
# LIGHTBASE DATABASE (server-side; read by apps/server)
# ============================================
# These are read by the Astro backend at runtime. They are NEVER
# bundled into the client when VITE_DB_PROVIDER=api.
#
# When VITE_DB_PROVIDER=lightbase, the VITE_-prefixed versions are
# also read by the React app (and therefore bundled). Only use that
# mode for local dev.

# Lightbase instance base URL (no trailing slash)
LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io
VITE_LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io

# Lightbase API key (root key for the project)
LIGHTBASE_API_KEY=lb_live_your_api_key_here
VITE_LIGHTBASE_API_KEY=lb_live_your_api_key_here

# Lightbase project ID (auto-generated from project name at creation)
LIGHTBASE_PROJECT_ID=minhaajulhuda-hub
VITE_LIGHTBASE_PROJECT_ID=minhaajulhuda-hub

# Lightbase tenant ID (defaults to "default")
VITE_LIGHTBASE_TENANT=default

# ============================================
# SESSION SECURITY (server-side; read by Astro backend)
# ============================================
# Secret used to sign session tokens (HMAC-SHA256). MUST be a long
# random string in production. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=your_long_random_session_secret_here

# JWT secret (also used by the legacy client-side auth; will be
# removed once all auth moves server-side)
VITE_JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Session expiry time in seconds (default: 7 days)
VITE_SESSION_EXPIRY=604800

# Require email verification for new users
VITE_REQUIRE_EMAIL_VERIFICATION=false

# OTP expiry time in minutes
VITE_OTP_EXPIRY=10

# ============================================
# GITHUB DATABASE (only required when VITE_DB_PROVIDER=github)
# ============================================
VITE_GITHUB_USER=your-github-username
VITE_GITHUB_REPO=your-repository-name
VITE_GITHUB_TOKEN=ghp_your_github_token_here
VITE_GITHUB_BRANCH=main

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# PAYSTACK (Primary for Nigerian payments)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
VITE_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# STRIPE (International payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
VITE_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# FLUTTERWAVE (African payments)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
VITE_FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key

# ============================================
# CLOUDINARY MEDIA MANAGEMENT
# ============================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
VITE_CLOUDINARY_API_SECRET=your_api_secret
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================
# EMAIL SERVICE CONFIGURATION
# ============================================
VITE_SMTP_ENDPOINT=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USERNAME=your-email@domain.com
VITE_SMTP_PASSWORD=your_smtp_password
VITE_SMTP_FROM=noreply@minhaajulhudaa.org
VITE_EMAIL_API_KEY=your_email_api_key

# ============================================
# ARCHIVE.ORG API INTEGRATION
# ============================================
VITE_ARCHIVE_ORG_API_KEY=your_archive_org_api_key
VITE_DEFAULT_QURAN_RECITER=AbdulBaset_AbdulSamad_Mujawwad_128kbps

# ============================================
# APPLICATION SETTINGS
# ============================================
VITE_APP_URL=http://localhost:8080
VITE_APP_ENV=development
VITE_DEBUG=true

# ============================================
# PLATFORM-SPECIFIC SETTINGS
# ============================================

# SCHOOL PLATFORM
VITE_SCHOOL_NAME=Minhaajulhudaa Islamic School
VITE_SCHOOL_CONTACT_EMAIL=school@minhaajulhudaa.org
VITE_SCHOOL_PHONE=+234-xxx-xxx-xxxx
VITE_SCHOOL_ADDRESS=Address Here

# MASJID PLATFORM
VITE_MASJID_NAME=Minhaajulhudaa Masjid
VITE_MASJID_LATITUDE=6.5244
VITE_MASJID_LONGITUDE=3.3792
VITE_MASJID_TIMEZONE=Africa/Lagos

# CHARITY PLATFORM
VITE_CHARITY_NAME=Minhaajulhudaa Charity
VITE_CHARITY_REGISTRATION_NUMBER=RC-xxxxx

# TRAVELS PLATFORM
VITE_TRAVELS_NAME=Minhaajulhudaa Travels
VITE_TRAVELS_LICENSE_NUMBER=TL-xxxxx

# ============================================
# ADMIN CREDENTIALS (env-based admin login per-platform)
# ============================================
# Format: username:password,username2:password2
VITE_ADMIN_USERS_SCHOOL=admin:your_school_admin_password
VITE_ADMIN_USERS_MASJID=admin:your_masjid_admin_password
VITE_ADMIN_USERS_CHARITY=admin:your_charity_admin_password
VITE_ADMIN_USERS_TRAVELS=admin:your_travels_admin_password

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

VITE_FACEBOOK_URL=https://facebook.com/minhaajulhudaa
VITE_TWITTER_URL=https://twitter.com/minhaajulhudaa
VITE_INSTAGRAM_URL=https://instagram.com/minhaajulhudaa
VITE_YOUTUBE_URL=https://youtube.com/@minhaajulhudaa

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
VITE_ENABLE_SMS_NOTIFICATIONS=false
VITE_ENABLE_CLOUDINARY=false
VITE_ENABLE_SEARCH=true
VITE_ENABLE_ANALYTICS=true
